# Supabase project that backs both the Flutter client and this dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the browser, never prefix with NEXT_PUBLIC_:
# it bypasses row level security.
SUPABASE_SERVICE_ROLE_KEY=

# Local sample cases only. Ignored (and the production build fails) when
# NODE_ENV=production. Never set this in a production deploy.
NEXT_PUBLIC_DEMO_MODE=
